# Maintainer: Roddy <rod@rod.sh>
pkgname=vesktop-voice-overlay
pkgver=1.2.0
pkgrel=1
pkgdesc="Wayland-native voice activity overlay for Vesktop"
arch=(x86_64)
url="https://github.com/Roddygithub/vesktop-voice-overlay"
license=(GPL-3.0-only)
depends=(gtk4 gtk4-layer-shell)
makedepends=(cargo pkg-config gtk4-layer-shell)
# rustc applies its own release-profile LTO; makepkg's gcc-based -flto
# produces bitcode objects (e.g. ring's C sources) rust-lld cannot consume.
options=(!lto)
install=$pkgname.install

source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver/overlay"
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver/overlay"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "overlay/target/release/vesktop-voice-overlay" \
    "$pkgdir/usr/bin/vesktop-voice-overlay"
  install -Dm644 "packaging/systemd/user/$pkgname.service" \
    "$pkgdir/usr/lib/systemd/user/$pkgname.service"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
