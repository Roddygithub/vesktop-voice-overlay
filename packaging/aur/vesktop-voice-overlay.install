post_install() {
  echo "Vesktop Voice Overlay installed!"
  echo ""
  echo "1. Install the Vencord plugin in Vesktop:"
  echo "   Settings → Plugins → Install from file (plugin .tgz from releases)"
  echo ""
  echo "2. Enable the user service so the overlay starts with your session:"
  echo "   systemctl --user enable --now vesktop-voice-overlay.service"
  echo ""
  echo "   Note: this requires your compositor session to activate"
  echo "   graphical-session.target (Hyprland via uwsm/UMU does; otherwise"
  echo "   add 'systemctl --user start vesktop-voice-overlay' to your autostart)."
}

post_upgrade() {
  post_install
}

pre_remove() {
  if systemctl --user is-enabled vesktop-voice-overlay.service >/dev/null 2>&1; then
    systemctl --user disable --now vesktop-voice-overlay.service
  fi
  echo "Don't forget to also remove the Vencord plugin from Vesktop Settings → Plugins"
}
